PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/codecollab
JWT_SECRET=change_this_to_a_long_random_string
SESSION_SECRET=change_this_to_a_different_long_random_string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JDoodle code execution API — https://www.jdoodle.com/compiler-api
# Free tier: 200 requests/day. At least one account required for execution.
JDOODLE_CLIENT_ID_1=your_actual_client_id_1
JDOODLE_CLIENT_SECRET_1=your_actual_client_secret_1
JDOODLE_CLIENT_ID_2=your_actual_client_id_2
JDOODLE_CLIENT_SECRET_2=your_actual_client_secret_2
JDOODLE_CLIENT_ID_3=your_actual_client_id_3
JDOODLE_CLIENT_SECRET_3=your_actual_client_secret_3
JDOODLE_CLIENT_ID_4=your_actual_client_id_4
JDOODLE_CLIENT_SECRET_4=your_actual_client_secret_4
JDOODLE_CLIENT_ID_5=your_actual_client_id_5
JDOODLE_CLIENT_SECRET_5=your_actual_client_secret_5
JDOODLE_CLIENT_ID_6=your_actual_client_id_6
JDOODLE_CLIENT_SECRET_6=your_actual_client_secret_6
JDOODLE_CLIENT_ID_7=your_actual_client_id_7
JDOODLE_CLIENT_SECRET_7=your_actual_client_secret_7
JDOODLE_CLIENT_ID_8=your_actual_client_id_8
JDOODLE_CLIENT_SECRET_8=your_actual_client_secret_8
# Optional
EXEC_TIMEOUT_MS=15000
