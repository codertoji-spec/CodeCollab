PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/codecollab
JWT_SECRET=change_this_to_a_long_random_string
SESSION_SECRET=change_this_to_a_different_long_random_string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JDoodle code execution API — https://www.jdoodle.com/compiler-api
# Free tier: 200 requests/day. Required — server will not start without these.
JDOODLE_CLIENT_ID=your_actual_client_id
JDOODLE_CLIENT_SECRET=your_actual_client_secret
# Optional
EXEC_TIMEOUT_MS=15000
